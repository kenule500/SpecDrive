{
  "name": "specdrive-cli",
  "version": "0.1.50",
  "description": "SpecDrive enterprise spec-driven development CLI",
  "bin": {
    "sdrive": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src/",
    "scripts/",
    "commands/",
    "schemas/",
    "agents/",
    "dashboard/",
    "mcp/",
    "migrations/",
    "templates/",
    "docs/",
    "logo.png",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.js test",
    "test:unit": "node scripts/run-tests.js test/unit",
    "test:e2e": "node scripts/run-tests.js test e2e",
    "lint": "node scripts/check-syntax.js",
    "encoding:check": "node scripts/check-encoding.js",
    "docs:check": "node scripts/check-docs.js",
    "permissions:check": "node src/index.js permissions:check",
    "pack:check": "npm pack --dry-run",
    "dogfood": "node scripts/sync-sdrive.js",
    "ci": "npm run lint && npm run encoding:check && npm test && npm run docs:check"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "spec-driven",
    "spec-driven-development",
    "sdd",
    "openspec",
    "ai-agents",
    "agentic",
    "governance",
    "cli",
    "specification",
    "developer-tools"
  ],
  "author": "SpecDrive",
  "license": "MIT",
  "logo": "logo.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenule500/SpecDrive.git"
  },
  "homepage": "https://github.com/kenule500/SpecDrive#readme",
  "bugs": {
    "url": "https://github.com/kenule500/SpecDrive/issues"
  }
}
