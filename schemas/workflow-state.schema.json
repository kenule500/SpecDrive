{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow State",
  "type": "object",
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "phase": {
            "enum": ["backlog", "ongoing", "completed", "blocked"]
          },
          "currentStep": {
            "enum": ["specification", "planning", "implementation", "review"]
          },
          "branch": {
            "type": "string"
          },
          "gates": {
            "type": "object",
            "properties": {
              "specification": {
                "enum": ["pending", "approved", "rejected"]
              },
              "planning": {
                "enum": ["pending", "approved", "rejected"]
              },
              "implementation": {
                "enum": ["pending", "in_progress", "approved", "rejected"]
              },
              "review": {
                "enum": ["pending", "approved", "rejected"]
              }
            },
            "required": [
              "specification",
              "planning",
              "implementation",
              "review"
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "string",
                  "minLength": 3
                },
                "by": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": ["event", "timestamp"]
            }
          }
        },
        "required": ["name", "phase", "currentStep", "gates"]
      }
    }
  },
  "required": ["features"],
  "additionalProperties": false
}